#include <windows.h>
#include "appversion.h"

#define IDI_APP 101
#define IDI_SAVE 102
#define IDI_BUILD 103
#define IDI_VERIFY 104
#define IDI_RUN 105
#define IDI_OPENFOLDER 106
#define IDI_CLEARLOG 107

IDI_APP ICON "sfxpress.ico"
IDI_SAVE ICON "btn-save.ico"
IDI_BUILD ICON "btn-build.ico"
IDI_VERIFY ICON "btn-verify.ico"
IDI_RUN ICON "btn-run.ico"
IDI_OPENFOLDER ICON "btn-openfolder.ico"
IDI_CLEARLOG ICON "btn-clearlog.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      APP_COMPANY
            VALUE "FileDescription",  APP_DESCRIPTION
            VALUE "FileVersion",      APP_VERSION
            VALUE "InternalName",     APP_NAME
            VALUE "OriginalFilename", "SfxPress.exe"
            VALUE "ProductName",      APP_NAME
            VALUE "ProductVersion",   APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END